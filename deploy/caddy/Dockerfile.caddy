# Caddy with the Cloudflare DNS module, for Let's Encrypt certificates through a DNS challenge.
# For another DNS provider swap the module: https://caddyserver.com/docs/modules/ (search "dns.providers").
FROM caddy:2-builder AS builder
RUN xcaddy build --with github.com/caddy-dns/cloudflare

FROM caddy:2
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
