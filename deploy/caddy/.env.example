# Copy to .env and fill in. .env holds secrets: it is git-ignored, keep it that way.

# The name you will type in the browser.
DOMAIN=calories.example.com

# How Caddy gets the certificate:
#   cloudflare  Let's Encrypt via a DNS challenge; DOMAIN is a Cloudflare-managed name that can point at a
#               home-network address. Nothing is exposed to the internet. (Recommended.)
#   internal    Caddy's own CA; no domain needed (e.g. DOMAIN=calorie-man.home.arpa or the server's IP).
#               Every device must trust Caddy's root certificate once.
#   public      Let's Encrypt over HTTP; forward ports 80 and 443 to this machine. Requires the password below.
CERTS=cloudflare

# CERTS=cloudflare: an API token with Zone / DNS / Edit permission for the zone of DOMAIN.
CLOUDFLARE_API_TOKEN=

# CERTS=public: the login in front of the app. Make the hash with
#   docker compose run --rm caddy caddy hash-password
# and keep the single quotes (the hash contains $ signs).
BASIC_AUTH_USER=
BASIC_AUTH_HASH=''

# Optional
TZ=America/Los_Angeles
USDA_API_KEY=
# HTTP_PORT=80
# HTTPS_PORT=443
